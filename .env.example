# Copy to .env and fill in. .env is gitignored; keep it that way.

# REQUIRED. Generate with: openssl rand -hex 32
# No default exists — the app refuses to start rather than run with a guessable session key.
FOURWATER_SECRET=

# --- The address this instance is reached at (strongly recommended) ------------------------------------
# e.g. https://plan-cph.4water.org  — no trailing slash.
# Without it, the first-admin invite link and each volunteer's calendar link are shown as PATHS, and a path
# pasted into a calendar app does nothing. The app deliberately will NOT infer this from the Host header: a
# request with a forged Host would render a link pointing at someone else's server, and the volunteer would
# paste their own calendar token into it.
FOURWATER_BASE_URL=

# --- NextCloud single sign-on (optional) ---------------------------------------------------------------
# Leave blank and the sign-in page will not offer NextCloud; admin-issued invite links still work, which is
# the intended path for volunteers who have no NextCloud account.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# --- Notifications (optional) -------------------------------------------------------------------------
# A Mattermost incoming webhook. THIS URL IS A CREDENTIAL: anyone holding it can post as the integration.
# Leave blank and messages queue in the notifications table instead of being lost.
MATTERMOST_WEBHOOK=

# --- Backup upload (optional) -------------------------------------------------------------------------
# Use a NextCloud APP PASSWORD, never the account password.
NEXTCLOUD_WEBDAV_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
