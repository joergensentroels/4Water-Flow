# ---------------------------------------------------------------------------------------------------------
# Databases. These hold every volunteer's name and contact details, so the patterns are deliberately BROAD:
# matching only the default filename left demo.db committable, and FOURWATER_DB can name the file anything.
# One "git add -A" publishing the roster is the same hazard tools/backup.mjs refuses to allow.
# ---------------------------------------------------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
backups/

# Generated by tools/demo.mjs: invented people and a season spanning today. Not 4water configuration, and
# regenerated in one command, so there is nothing to preserve.
demo-pattern.json

# Secrets: session key, OIDC client secret, NextCloud app password, Mattermost webhook.
.env
.env.*
!.env.example

# Scratch left behind by an interrupted atomic config write.
config/*.tmp

# Node, in case a dependency ever appears — which would itself be the news.
node_modules/
npm-debug.log*
